if(USE_STDIN)
    execute_process(COMMAND "${PROGRAM}" INPUT_FILE "${INPUT}"
        RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error TIMEOUT 10 ENCODING UTF-8)
else()
    execute_process(COMMAND "${PROGRAM}" "${INPUT}"
        RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE error TIMEOUT 10 ENCODING UTF-8)
endif()

if(FAIL_EXPECTED)
    string(FIND "${error}" "Ошибка: " error_prefix)
    if(NOT "${status}" STREQUAL "1" OR NOT error_prefix EQUAL 0 OR NOT "${actual}" STREQUAL "")
        message(FATAL_ERROR "Expected exit code 1, error message and empty stdout; got ${status}: ${actual} ${error}")
    endif()
else()
    if(NOT "${status}" STREQUAL "0" OR NOT "${error}" STREQUAL "")
        message(FATAL_ERROR "Program failed: ${status}: ${error}")
    endif()
    file(READ "${EXPECTED}" expected)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    string(REPLACE "\r\n" "\n" expected "${expected}")
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected:\n${expected}\nReceived:\n${actual}")
    endif()
endif()
